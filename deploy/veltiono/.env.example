# Quickly for Veltiono — copy to /opt/quickly/.env, chmod 600. Never commit the real file.
# App + compose settings ONLY: this whole file is passed to the app container. Backup, R2 and
# Telegram secrets live in ops.env (see ops.env.example).
# Read by docker compose AND sourced by bash: no spaces, quotes, `$` or `#` in values
# (generated hex/base64 values are fine).

# ── Compose ──────────────────────────────────────────────────────────────
# nginx on the host:   docker-compose.yml:docker-compose.nginx.yml
# Traefik on the host: docker-compose.yml:docker-compose.traefik.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml
QUICKLY_IMAGE=ghcr.io/travel2space/quickly
# Exact version tag (vX.Y.Z). `latest` is refused by scripts/update.sh.
QUICKLY_IMAGE_TAG=v0.1.0
QUICKLY_PORT=5050
QUICKLY_HOST=outreach.veltiono.eu
# Traefik overlay only:
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ── Database (letters and digits only: it is embedded in a URL) ──────────
POSTGRES_USER=quickly
POSTGRES_DB=quickly
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────
BASE_URL=https://outreach.veltiono.eu
CORS_ORIGINS=https://outreach.veltiono.eu
# Sessions + API-key hashing. Unset = a new key on every start (logins and API keys break).
# openssl rand -hex 32 — keep a copy in the password manager.
QUICKLY_SECRET_KEY=
# Encrypts inbox SMTP/IMAP passwords at rest. Losing it = re-enter every inbox password.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# — keep a copy in the password manager.
QUICKLY_ENCRYPTION_KEY=
# UI sign-in (Google OAuth client, redirect https://outreach.veltiono.eu/oauth/app/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Pre-send check (spec 1, Q-4) ─────────────────────────────────────────
PRESEND_URL=https://veltiono.gr/api/partners/outreach/may-send
# = QUICKLY_PRESEND_SECRET in Vercel Production (read once the q-unsub release is deployed)
PRESEND_SECRET=
PRESEND_TIMEOUT_SECONDS=5
PRESEND_TOKEN_FIELD=veltiono_token
PRESEND_SUPPRESS_REASONS=do_not_contact
