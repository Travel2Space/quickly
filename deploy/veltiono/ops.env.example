# Quickly ops secrets — copy to /opt/quickly/ops.env, chmod 600. Never commit the real file.
# Read ONLY by the host scripts (sourced by bash); deliberately NOT in .env, because compose
# hands the whole .env to the app container (`env_file`) and the app has no use for the R2 or
# Telegram credentials. No spaces, quotes, `$` or `#` in values.

# ── Backups → Cloudflare R2 (EU bucket: the endpoint has an `.eu.` segment) ─
# Public key only — the private key never touches this server.
BACKUP_AGE_PUBLIC_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=veltiono-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RETENTION_DAYS=30

# ── Alerts → Telegram ops chat ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
# Checked through the proxy: TLS + proxy + app + DB.
HEALTH_URL=https://outreach.veltiono.eu/health

# ── Optional overrides (defaults shown; the local test sets some) ────────
# DISK_ALERT_PCT=85
# UPDATE_HEALTH_TIMEOUT=120
# TELEGRAM_API_URL=https://api.telegram.org
# R2_ENDPOINT=https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2_REGION=auto
# AWS_NETWORK=host
# AWS_CLI_IMAGE=amazon/aws-cli:2.22.35
